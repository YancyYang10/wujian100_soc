#!/bin/env perl

use strict;
use warnings FATAL => 'all';
use Term::ANSIColor qw(:constants);
use Getopt::Long;
    $Getopt::Long::ignorecase = 0;
use File::Copy;
use Cwd;
use FileHandle;
use File::Basename;
no strict 'refs';
my $pwd = `pwd`;
chomp($pwd);

my $path;
my $case;
my $case_file;
my $case_make;
my $output;
my $had_v;
my @file;
foreach(@ARGV){
	if(/(.*\/)(.*)/){
		$case_file = $_;
		$path = "$ENV{PROJ_HOME}/verify/st/c_case/" . $1;
		$case = $2;
	}else{
		$case_file = $_;
		$case = $_;
		chomp($path = `pwd`);
	}
  
  print "case_file: $case_file\n";
  print "path     : $path\n";
  print "case     : $case\n";

  $output = $case . '_code_' . $$;
  system "rm -rf $output" if -e $output;
  mkdir $output;
  chdir $output;
	if($case =~ /(.*)\.s/){
		$case_make = $1;
		!system("cp $case_file .") or die "can't copy $case_file";
	}

	if($case =~ /(.*)\.c/){
		$case_make = $1;
		chomp(@file = `ls $path`);
		foreach(@file){
			if(/CVS/){
				undef $_;
			}else{
				my $file = "$path"."\/"."$_";
				print "$file\n";
        if($file =~ /\.c/) {
          !system("cp $file .") or die "can't copy $file";
        }
			}
		}
    !system("cp $ENV{PROJ_HOME}/verify/firmware_ksim/lib/clib/*.h  .") or die "can't copy clib program";
    !system("cp $ENV{PROJ_HOME}/verify/firmware_ksim/lib/clib/*.c  .") or die "can't copy clib program";
    !system("cp $ENV{PROJ_HOME}/verify/firmware_ksim/lib/newlib_wrap/*.c .") or die "can't copy clib program";
	}
}

!system("cp $ENV{PROJ_HOME}/verify/firmware_ksim/lib/Makefile ./Makefile") or die "cant't copy";
!system("cp $ENV{PROJ_HOME}/verify/firmware_ksim/lib/crt0.s ./crt0.s") or die "cant't copy";
!system("cp $ENV{PROJ_HOME}/verify/firmware_ksim/lib/linker.lcf ./linker.lcf") or die "cant't copy";

my $data_addr = 0;
$data_addr = 20000000;
!system("sed -i 's/DATA_BADDR/0x$data_addr/g' linker.lcf") or die "cant't replace";

!system("make clean; make all CPU=e902m ENDIAN_MODE=little-endian FILE=$case_make HGPR=") or die "can't make";


my $pat_name = "$case_make.pat";
my $pat_tmp  = "../.$pat_name.$$";
!system("cp test.pat $pat_tmp") or die "cant't copy $pat_tmp";
!system("mv $pat_tmp ../$pat_name") or die "cant't move $pat_name";
print "PAT_FILE: ../$pat_name\n";

chdir($pwd);
system("rm -rf $output");
